# API Port Configuration
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace <password> and <cluster> with your actual values
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ganga-studio?retryWrites=true&w=majority&appName=Ganga"

# JWT Secret for Authentication
# Use a strong, random string in production (e.g., generated via 'openssl rand -base64 32')
JWT_SECRET=supersecret_ganga_studio_key
